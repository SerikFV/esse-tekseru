# Get a key at https://aistudio.google.com/apikey. Never commit the real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90
DATABASE_URL=postgresql+psycopg://esse:CHANGE_ME@127.0.0.1:5432/esse
# Used by compose.yaml; use the same password in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME

# Gmail: use a Google App Password, never your regular Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=tekSER
SMTP_SSL=false
# Local HTTP: false. Public HTTPS deployment: true.
COOKIE_SECURE=false
SESSION_DAYS=7
# Public deployment origin, e.g. https://tekser.example (without a trailing slash).
SITE_URL=
