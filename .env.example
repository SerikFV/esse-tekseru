# Get a key at https://aistudio.google.com/apikey. Never commit the real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=90
DATABASE_URL=postgresql+psycopg://esse:CHANGE_ME@127.0.0.1:5432/esse
# Used by compose.yaml; use the same password in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
